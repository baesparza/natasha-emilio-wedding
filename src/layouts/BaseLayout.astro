---
import '../styles/global.css';
import ImageParallax from '../islands/ImageParallax.astro';
import ScrollReveal from '../islands/ScrollReveal.astro';
import SmoothScroll from '../islands/SmoothScroll.astro';
import Seo from '../components/Seo.astro';
import type { ImageMetadata } from 'astro';
import type { WeddingTheme } from '@/content/types';

interface Props {
	title?: string;
	description?: string;
	ogImage?: ImageMetadata;
	ogImageAlt?: string;
	canonicalUrl?: string;
	lang?: string;
	theme?: WeddingTheme;
	noindex?: boolean;
	event?: {
		name: string;
		startDate: string;
		endDate?: string;
		locationName: string;
		locationAddress?: string;
	};
}

const {
	title = 'Studio Wedding',
	description = 'A premium, mobile-first wedding invitation experience.',
	ogImage,
	ogImageAlt,
	canonicalUrl,
	lang = 'en',
	theme,
	noindex = false,
	event,
} = Astro.props;

const pageTitle = title === 'Studio Wedding' ? title : `${title} · Studio Wedding`;
// Maps camelCase theme keys → --color-* CSS vars on <body>
const themeStyle = theme
	? Object.entries(theme.colors)
			.map(([name, value]) => {
				const token = name.replace(/([A-Z])/g, '-$1').toLowerCase();
				return `--color-${token}: ${value}`;
			})
			.join('; ')
	: undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content={theme?.colors.surface ?? '#ffffff'} />

		<Seo
			title={pageTitle}
			description={description}
			image={ogImage}
			imageAlt={ogImageAlt}
			canonicalUrl={canonicalUrl}
			locale={lang}
			noindex={noindex}
			event={event}
		/>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Baskervville:ital@0;1&family=Baskervville+SC&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Parisienne&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<slot name="head" />
	</head>
	<body style={themeStyle}>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2"
		>
			Saltar al contenido
		</a>

		<slot name="header" />

		<main id="main">
			<slot />
		</main>

		<slot name="footer" />

		<!-- Global motion islands -->
		<SmoothScroll />
		<ImageParallax />
		<ScrollReveal />
		<slot name="islands" />
	</body>
</html>
