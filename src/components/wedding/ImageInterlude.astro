---
import type { Wedding } from '@/content/types';
import OptimizedImage from '@/components/OptimizedImage.astro';

interface Props {
	interlude: Wedding['interlude'];
}

const { interlude } = Astro.props;
---

<section class="bg-wedding-surface py-section" aria-label="Momento de la celebración">
	<div class="px-gutter mx-auto max-w-5xl">
		<figure class="relative">
			<div class="border-wedding-lavender/30 overflow-hidden border">
				<OptimizedImage
					src={interlude.image}
					alt={interlude.imageAlt}
					class="aspect-5/4 w-full object-cover sm:aspect-16/10"
					widths={[480, 768, 1024, 1440]}
					sizes="(min-width: 1024px) 960px, 100vw"
					pictureClass="block"
					loading="lazy"
					parallax={16}
				/>
			</div>

			<!-- Caption card overlaps the photo -->
			<figcaption
				class="border-wedding-lavender/20 bg-wedding-surface relative mx-auto -mt-12 w-[min(100%,28rem)] border px-6 py-9 text-center sm:-mt-16 sm:px-10 sm:py-11"
			>
				<p
					class="text-wedding-ink-muted mx-auto max-w-[22ch] font-serif text-2xl leading-[1.4] text-balance italic sm:text-3xl"
				>
					{interlude.caption}
				</p>
				<span class="bg-wedding-rosewood/55 mx-auto mt-7 block h-px w-14" aria-hidden="true">
				</span>
			</figcaption>
		</figure>
	</div>
</section>
