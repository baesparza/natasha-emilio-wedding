---
import type { Wedding } from '@/content/types';

interface Props {
	indications: Wedding['indications'];
}

const { indications } = Astro.props;

const rules = [indications.children, { title: 'Invitados', body: indications.guests }] as const;
const dressColors = indications.dressCode.colors ?? [];
const examplesUrl = indications.dressCode.examplesUrl;
const reservedSwatch = indications.reservedColor ?? { name: 'Reservado', value: undefined };
const reservedIsCustom = Boolean(indications.reservedColor);
---

<!-- Attendance rules -->
<section class="bg-wedding-surface py-section">
	<div class="px-gutter mx-auto max-w-4xl">
		<header class="mx-auto max-w-3xl text-center">
			<h2 class="text-wedding-olive text-3xl text-balance">
				Aquí te dejamos unas indicaciones
				<span class="text-wedding-ink-strong mt-1 block">para tu asistencia…</span>
			</h2>
		</header>

		<div class="mx-auto mt-14 grid max-w-2xl gap-12 sm:mt-16 sm:grid-cols-2 sm:gap-0">
			{
				rules.map((rule, index) => (
					<article
						class:list={[
							'px-2 text-center sm:px-8',
							index === 0 && 'sm:border-wedding-rosewood/35 sm:border-r',
						]}
					>
						<h3 class="font-label text-wedding-ink-strong text-xl tracking-[0.06em]">
							{rule.title}
						</h3>
						<p class="text-wedding-ink-muted mx-auto mt-4 max-w-[16rem] text-base leading-[1.7] font-light text-pretty">
							{rule.body}
						</p>
					</article>
				))
			}
		</div>

		<!-- Dress code -->
		<div
			class="border-wedding-rosewood/30 mx-auto mt-16 max-w-2xl border-t pt-14 text-center sm:mt-20 sm:pt-16"
		>
			<h3 class="font-label text-wedding-ink-strong text-xl tracking-[0.06em]">Dress Code</h3>
			<p class="text-wedding-ink-muted mx-auto mt-3 max-w-sm text-base font-light text-pretty">
				{indications.dressCode.description}
			</p>

			{
				dressColors.length > 0 && (
					<ul
						class="mx-auto mt-10 grid max-w-xs grid-cols-2 gap-3 sm:max-w-2xl sm:grid-cols-4 sm:gap-4"
						aria-label="Paleta de colores del dress code"
					>
						{dressColors.map((color) => (
							<li>
								<figure class="bg-wedding-surface ring-wedding-ink/12 aspect-[3/4] overflow-hidden shadow-[0_2px_8px_rgba(16,16,16,0.08)] ring-1">
									<div class="h-[72%] w-full" style={`background-color: ${color.value}`} />
									<figcaption class="bg-wedding-surface flex h-[28%] items-center px-3 text-left sm:px-3.5">
										<p class="font-label text-wedding-ink-strong text-sm leading-tight font-medium tracking-[0.06em] sm:text-base">
											{color.name}
										</p>
									</figcaption>
								</figure>
							</li>
						))}
					</ul>
				)
			}

			{
				examplesUrl && (
					<a
						href={examplesUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-wedding-ink-muted decoration-wedding-rosewood mt-10 inline-flex items-center gap-2 text-sm font-medium tracking-[0.08em] uppercase underline underline-offset-4 transition-transform hover:translate-x-1"
					>
						<span aria-hidden="true">→</span>
						Mira los siguientes ejemplos
					</a>
				)
			}
		</div>
	</div>
</section>

<!-- Reserved / avoid color -->
<section
	class:list={[
		'px-gutter py-[clamp(3.5rem,9vw,5.5rem)]',
		reservedIsCustom ? 'bg-wedding-olive' : 'bg-wedding-lavender',
	]}
>
	<div class="mx-auto flex max-w-md flex-col items-center gap-8 text-center">
		<p
			class="font-label text-wedding-surface decoration-wedding-surface text-xl text-balance underline underline-offset-4"
		>
			{indications.reservedColorMessage}
		</p>
		<figure
			class="bg-wedding-surface ring-wedding-surface/50 aspect-[3/4] w-32 overflow-hidden shadow-[0_2px_8px_rgba(16,16,16,0.1)] ring-1 sm:w-36"
			aria-hidden="true"
		>
			<div
				class:list={['h-[72%] w-full', !reservedIsCustom && 'bg-wedding-bride']}
				style={reservedIsCustom ? `background-color: ${reservedSwatch.value}` : undefined}
			>
			</div>
			<figcaption class="bg-wedding-surface flex h-[28%] items-center px-3 text-left">
				<p
					class="font-label text-wedding-ink-strong text-sm leading-tight font-medium tracking-[0.06em] sm:text-base"
				>
					{reservedSwatch.name}
				</p>
			</figcaption>
		</figure>
	</div>
</section>
