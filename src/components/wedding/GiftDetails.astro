---
import type { Wedding } from '@/content/types';

interface Props {
	gift: Wedding['gift'];
}

const { gift } = Astro.props;
---

<section class="bg-wedding-surface py-section">
	<div class="px-gutter mx-auto max-w-6xl text-center">
		<h2 class="text-wedding-rosewood mx-auto max-w-2xl text-3xl text-balance">
			{gift.heading}
		</h2>
		<p class="text-wedding-ink-muted mx-auto mt-6 max-w-2xl text-base font-light text-pretty">
			{gift.description}
		</p>

		<div class="mx-auto mt-14 max-w-lg sm:mt-16">
			<div
				class="gift-card border-wedding-olive relative border p-px shadow-[0_12px_40px_-12px_rgb(16_16_16/28%),0_2px_8px_-2px_rgb(16_16_16/10%)]"
			>
				<!-- Decorative corner accents -->
				<span class="gift-corner gift-corner--tl" aria-hidden="true"></span>
				<span class="gift-corner gift-corner--tr" aria-hidden="true"></span>
				<span class="gift-corner gift-corner--bl" aria-hidden="true"></span>
				<span class="gift-corner gift-corner--br" aria-hidden="true"></span>

				<div class="bg-wedding-surface relative z-10 px-6 py-12 text-center sm:px-10">
					<p class="text-xl font-medium">{gift.bank}</p>
					<p class="mt-6 text-base">
						Nro. de cuenta: <strong>{gift.accountNumber}</strong>
					</p>
					<p class="text-wedding-ink-muted mt-1 text-sm">{gift.accountType}</p>

					<div class="mt-8 grid gap-6 sm:grid-cols-[1fr_auto_1fr] sm:items-center">
						<div>
							<strong>{gift.holders[0].name}</strong>
							<p class="text-sm">{gift.holders[0].id}</p>
						</div>
						<span class="font-label text-wedding-rosewood text-4xl" aria-hidden="true">&</span>
						<div>
							<strong>{gift.holders[1].name}</strong>
							<p class="text-sm">{gift.holders[1].id}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.gift-card {
		isolation: isolate;
	}

	.gift-corner {
		pointer-events: none;
		position: absolute;
		z-index: 20;
		width: 3.25rem;
		height: 3.25rem;
		background: var(--color-olive);
	}

	.gift-corner--tl {
		top: -0.4rem;
		left: -0.4rem;
		clip-path: polygon(0 0, 100% 0, 0 100%);
		filter: drop-shadow(2px 2px 3px rgb(16 16 16 / 22%));
	}

	.gift-corner--tr {
		top: -0.4rem;
		right: -0.4rem;
		clip-path: polygon(0 0, 100% 0, 100% 100%);
		filter: drop-shadow(-2px 2px 3px rgb(16 16 16 / 22%));
	}

	.gift-corner--bl {
		bottom: -0.4rem;
		left: -0.4rem;
		clip-path: polygon(0 0, 0 100%, 100% 100%);
		filter: drop-shadow(2px -2px 3px rgb(16 16 16 / 22%));
	}

	.gift-corner--br {
		bottom: -0.4rem;
		right: -0.4rem;
		clip-path: polygon(100% 0, 100% 100%, 0 100%);
		filter: drop-shadow(-2px -2px 3px rgb(16 16 16 / 22%));
	}
</style>
