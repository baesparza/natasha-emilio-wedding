---
import type { Wedding } from '@/content/types';

interface Props {
	hero: Wedding['hero'];
	couple: Wedding['couple'];
}

const { hero, couple } = Astro.props;
---

<header class="bg-wedding-surface px-gutter py-[clamp(1.25rem,4vw,3rem)]">
	<div class="mx-auto max-w-6xl">
		<img
			src="/weddings/natasha-emilio/logo.jpg"
			alt={`Monograma de ${couple.primaryName} y ${couple.secondaryName}`}
			class="w-20 sm:w-24"
		/>

		<!-- Photo + copy; on mobile the card overlaps the image -->
		<div
			class="mt-[clamp(1.5rem,5vw,4rem)] grid items-center gap-0 lg:grid-cols-[minmax(18rem,0.88fr)_minmax(20rem,1.12fr)] lg:gap-[clamp(3rem,8vw,8rem)]"
		>
			<figure
				class="border-wedding-lavender/30 bg-wedding-surface w-[82%] overflow-hidden border lg:w-full"
			>
				<img
					src={hero.image}
					alt={hero.imageAlt}
					class="aspect-4/5 h-full w-full object-cover"
					fetchpriority="high"
				/>
			</figure>

			<div
				class="border-wedding-lavender/20 bg-wedding-surface relative -mt-12 ml-[10%] max-w-xl border px-6 py-9 text-center sm:px-10 sm:py-12 lg:mt-0 lg:ml-0 lg:border-0 lg:bg-transparent lg:px-0 lg:py-0 lg:text-left"
			>
				<p class="text-wedding-olive mb-5 text-sm font-semibold tracking-[0.28em]">
					{hero.eyebrow}
				</p>
				<h1
					class="font-script text-wedding-ink-muted mx-auto max-w-[12ch] text-8xl leading-[0.94] lg:mx-0"
				>
					{hero.headline}
				</h1>
				<a
					href="#celebracion"
					class="text-wedding-rosewood decoration-wedding-rosewood mt-9 inline-flex text-sm font-semibold tracking-[0.18em] uppercase underline underline-offset-8"
				>
					Más información
				</a>
			</div>
		</div>
	</div>
</header>
