---
import type { Wedding } from '@/content/types';
import MusicToggle from '@/components/wedding/MusicToggle.astro';
import OptimizedImage from '@/components/OptimizedImage.astro';

interface Props {
	hero: Wedding['hero'];
	couple: Wedding['couple'];
	music?: Wedding['music'];
}

const { hero, couple, music } = Astro.props;
---

<header class="bg-wedding-surface px-gutter py-[clamp(1.25rem,4vw,3rem)]">
	<div class="mx-auto max-w-6xl">
		{
			hero.logo && (
				<div data-reveal>
					<OptimizedImage
						src={hero.logo}
						alt={`Monograma de ${couple.primaryName} y ${couple.secondaryName}`}
						class="w-20 sm:w-24"
						widths={[80, 160, 240]}
						sizes="96px"
						pictureClass="block"
					/>
				</div>
			)
		}
		<!-- TODO: Request or create a monogram for tenants without a logo. -->

		<!-- Photo + copy; on mobile the card overlaps the image -->
		<div
			class="mt-[clamp(1.5rem,5vw,4rem)] grid items-center gap-0 lg:grid-cols-[minmax(18rem,0.88fr)_minmax(20rem,1.12fr)] lg:gap-[clamp(3rem,8vw,8rem)]"
		>
			<figure
				class="border-wedding-lavender/30 bg-wedding-surface w-[82%] overflow-hidden border lg:w-full"
			>
				<OptimizedImage
					src={hero.image}
					alt={hero.imageAlt}
					class="aspect-5/7 h-full w-full object-cover"
					widths={[480, 720, 960, 1200]}
					sizes="(min-width: 1024px) 42vw, 82vw"
					pictureClass="block h-full w-full"
					loading="eager"
					fetchpriority="high"
					parallax={12}
				/>
			</figure>

			<div
				class="border-wedding-lavender/20 bg-wedding-surface relative -mt-12 ml-[10%] max-w-xl border px-6 py-9 text-center sm:px-10 sm:py-12 lg:mt-0 lg:ml-0 lg:border-0 lg:bg-transparent lg:px-0 lg:py-0 lg:text-left"
				data-reveal-stagger
			>
				<p class="text-wedding-olive mb-5 text-sm font-semibold tracking-[0.28em]" data-reveal>
					{hero.eyebrow}
				</p>
				<h1
					class="font-script text-wedding-ink-muted mx-auto max-w-[12ch] text-8xl leading-[0.94] lg:mx-0"
					data-reveal
				>
					{hero.headline}
				</h1>
				<div class="mt-9 flex flex-col items-center gap-5 lg:items-start" data-reveal>
					<a
						href="#celebracion"
						class="text-wedding-rosewood decoration-wedding-rosewood inline-flex text-sm font-semibold tracking-[0.18em] uppercase underline underline-offset-8"
					>
						Más información
					</a>
					{music && <MusicToggle music={music} />}
				</div>
			</div>
		</div>
	</div>
</header>
